load("@sif//rules:crate.bzl", "crate")
load("@sif//rules:include.bzl", "include")

crate(
    name="core",
    crate_name="sif_core",
    root="core/lib.rs",
    srcs=glob(["core/**/*.rs"]),
)

crate(
    name="kernel",
    crate_name="sif",
    root="kernel/lib.rs",
    srcs=glob(["kernel/**/*.rs"]),
    deps=[
        ":core",
    ],
    aliased_deps={
        "sif_arch": select(
            {
                "sif//constraints:arch[arm]": "sif//kernel/arch:arm",
            },
        ),
    },
)

include(
    name="ld-include",
    files=glob(["**/*.ld"]),
)
