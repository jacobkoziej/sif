load("@sif//rules:crate.bzl", "crate")
load("@sif//rules:include.bzl", "include")

crate(
    name="core",
    crate_name="sif_core",
    root="core/lib.rs",
    srcs=glob(["core/**/*.rs"]),
)

crate(
    name="kernel",
    crate_name="sif",
    root="kernel/lib.rs",
    srcs=glob(["kernel/**/*.rs"]),
    deps=[
        ":core",
        select(
            {
                "sif//constraints:arch[arm]": "sif//kernel/arch/arm:sif_arch",
            },
        ),
        select(
            {
                "sif//constraints:vendor[raspberry-pi]": select(
                    {
                        "sif//constraints/vendor/raspberry-pi:mcu[rp2350a]": "sif//kernel/mcu/raspberry-pi/rp2350a:sif_mcu",
                    },
                ),
            },
        ),
    ],
)

include(
    name="ld-include",
    files=glob(["**/*.ld"]),
)
