HIDDEN(ELF32_HEADER_SIZE = 52);
HIDDEN(ELF32_PROGRAM_HEADER_SIZE = 32);

PROVIDE_HIDDEN(ELF_HEADER_SIZE = ELF32_HEADER_SIZE);
PROVIDE_HIDDEN(ELF_PROGRAM_HEADER_SIZE = ELF32_PROGRAM_HEADER_SIZE);

PROVIDE_HIDDEN(ELF_PROGRAM_HEADERS_ALLOCATION = ELF_PROGRAM_HEADER_SIZE * 4);
