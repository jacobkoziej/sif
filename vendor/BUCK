    "derivation_output_path",
    "get_system",
)
load("@sif//rules:crate.bzl", "crate_unwrapped")
load("@sif//vendor:rules.bzl", "src")

src(
    name="rustlib",
    flake=".",
    derivation=["packages", "rust-src"],
    path=".",
    sub_paths=[
        "compiler-builtins/compiler-builtins/src/lib.rs",
        "core/src/lib.rs",
    ],
)

crate_unwrapped(
    name="compiler_builtins",
    root=":rustlib[compiler-builtins/compiler-builtins/src/lib.rs]",
    src_deps=[":rustlib"],
    deps=[":core"],
    features=[
        "arch",
        "compiler-builtins",
    ],
    visibility=["PUBLIC"],
)

crate_unwrapped(
    name="core",
    root=":rustlib[core/src/lib.rs]",
    src_deps=[":rustlib"],
    cfg=[
        "no_fp_fmt_parse",
    ],
    visibility=["PUBLIC"],
)

derivation_output_path(
    name="miri-sysroot",
    flake=".",
    derivation=["packages", "miri-sysroot"],
    system=get_system(),
    path=[],
    target_compatible_with=get_host_constraints(),
)
