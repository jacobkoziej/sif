# SPDX-License-Identifier: MPL-2.0

root = true

[*]
indent_style = tab
indent_size = tab
tab_width = 8
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[{*.bzl,BUCK,PACKAGE}]
indent_style = space
indent_size = 4

[*.{md,nix,yaml}]
indent_style = space
indent_size = 2
